# Docker Compose Environment Variables
# Copy this file to .env and update the values
# NEVER commit .env to version control

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=social_support

# Neo4j Configuration
# Format: username/password
NEO4J_AUTH=neo4j/change_me_to_strong_password

# ============================================
# LLM Provider Configuration
# ============================================

# Choose LLM provider: "ollama" (local) or "streamlake" (cloud)
# Recommended: streamlake for production (cloud-hosted kat-coder-pro-v2.5)
# Use ollama for local development with no API key required
LLM_PROVIDER=streamlake

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3.5:14b

# StreamLake Configuration (Cloud) - Recommended for production
# Obtain API key from https://streamlake.ai
# Health-check endpoint: GET /api/v1/health/llm
STREAMLAKE_BASE_URL=https://vanchin.streamlake.ai/api/gateway/coding/v1
STREAMLAKE_API_KEY=your_streamlake_api_key_here
STREAMLAKE_MODEL=kat-coder-pro-v2.5

# ============================================
# Embedding Configuration
# ============================================

# Embeddings always run locally on Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ============================================
# Langfuse Configuration (Self-Hosted v4)
# ============================================

# Langfuse web UI and authentication
LANGFUSE_NEXTAUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# Langfuse security secrets
# Generate SALT with: openssl rand -base64 16
LANGFUSE_SALT=change_me_generate_with_openssl_rand_base64_16
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Langfuse PostgreSQL (dedicated instance)
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=change_me_langfuse_postgres_password
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:change_me_langfuse_postgres_password@langfuse-postgres:5432/langfuse

# ClickHouse (analytics database for Langfuse v4)
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=change_me_clickhouse_password
LANGFUSE_CLICKHOUSE_DB=default
LANGFUSE_CLICKHOUSE_URL=http://langfuse-clickhouse:8123
LANGFUSE_CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse-clickhouse:9000
LANGFUSE_CLICKHOUSE_CLUSTER_ENABLED=false

# Redis (cache and queue for Langfuse)
LANGFUSE_REDIS_HOST=langfuse-redis
LANGFUSE_REDIS_PORT=6379
LANGFUSE_REDIS_AUTH=change_me_redis_password

# MinIO / S3-compatible storage (events and media)
LANGFUSE_S3_ACCESS_KEY_ID=minio
LANGFUSE_S3_SECRET_ACCESS_KEY=change_me_minio_secret_key
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# Langfuse telemetry (set to false for privacy)
LANGFUSE_TELEMETRY_ENABLED=false

# Langfuse SDK configuration (used by application code)
# These are obtained from the Langfuse UI after first login
LANGFUSE_PUBLIC_KEY=pk-lf-obtain-from-langfuse-ui
LANGFUSE_SECRET_KEY=sk-lf-obtain-from-langfuse-ui
LANGFUSE_HOST=http://localhost:4000
